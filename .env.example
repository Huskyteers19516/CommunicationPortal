# ── Database ────────────────────────────────────────────────────────────────
# Local dev: `npm run db:start` runs Postgres on port 54329 (no Docker needed).
# Production: use your host's POOLED connection string (Neon "-pooler" host, Supabase port 6543 …).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/portal"
# Optional: a DIRECT (non-pooled) connection used only for running migrations. Neon/Supabase give you both.
DIRECT_URL=""

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the site — used for links inside emails.
APP_URL="http://localhost:3000"
# "Today" for checklists is computed in this timezone (team is in Anaheim, CA).
TEAM_TIMEZONE="America/Los_Angeles"
# Bootstraps the FIRST admin (the person who approves leaders/mentors/teachers): while no active admin
# exists, whoever registers or signs in with one of these emails becomes an ACTIVE admin. After that,
# add/remove admins in Admin → People. CLI alternative: `npm run admin -- --email you@example.com --name "Your Name"`.
ADMIN_EMAILS=""
# Strongly recommended in production: everyone must enter this code to register (keeps strangers out).
TEAM_JOIN_CODE=""
# Self-hosting behind your own reverse proxy (nginx, Caddy…)? Set to "true" so rate limits use the
# X-Forwarded-For client IP. Leave empty on Vercel (handled automatically) or with no proxy.
TRUST_PROXY_HEADERS=""

# ── Email (pick ONE; if neither is set, emails are only logged — fine for local dev) ──
# Option A — any SMTP server (e.g. Gmail with an App Password: host smtp.gmail.com, port 465)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Option B — Resend (https://resend.com) HTTP API. Free tier: 100 emails/day — a busy 35-person team can exceed that;
# Gmail (~500/day) or a paid plan is safer.
RESEND_API_KEY=""
# Optional — post new questions and replies (in full) to a LEADERS-ONLY Discord channel.
# Discord: channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=""
# Sender shown on emails, e.g. "Huskyteers Portal <portal@yourdomain.com>" (Gmail: must be your Gmail address)
EMAIL_FROM="Huskyteers Portal <no-reply@example.com>"

# ── File storage (optional) ─────────────────────────────────────────────────
# Uploaded files live in the database (300 MB cap) unless ALL FOUR of these are set: then new files go to a
# private Cloudflare R2 bucket (8 GB cap; R2 is free up to 10 GB). Steps: README → "More room for files".
# Server-only secrets: set them in Vercel, never in code. Leave R2_ENDPOINT empty (it's only for tests).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
