// Huskyteers Portal — FTC 19516 team communication app.
// Postgres everywhere (local: embedded-postgres via `npm run db:start`; prod: Neon/Supabase/etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Position on the team. Leaders/mentors/teachers need admin approval.
enum Role {
  MEMBER
  SOFTWARE_LEADER
  BUILD_LEADER
  BUSINESS_LEADER
  CAPTAIN
  MENTOR
  TEACHER
}

enum Subteam {
  SOFTWARE
  BUILD
  BUSINESS
}

enum AccountStatus {
  PENDING // waiting for admin approval (leaders, mentors, teachers)
  ACTIVE
  REJECTED
  DISABLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

/// Lifecycle of one member's copy of a task (the checklist item).
/// TODO -> SUBMITTED (member checks it) -> APPROVED (leader verifies)  = officially done
///                                      -> REJECTED (leader sends back with a note) -> SUBMITTED ...
/// SUBMITTED -> TODO when the member withdraws (unchecks) before review.
enum AssignmentStatus {
  TODO
  SUBMITTED
  APPROVED
  REJECTED
}

enum QuestionStatus {
  OPEN // waiting for a staff reply
  ANSWERED // staff replied, waiting on the asker
  RESOLVED // asker (or staff) closed it
}

/// Review state of a Resources-page entry. Members' submissions wait for someone with admin access.
enum ResourceStatus {
  PENDING // shared by a member, waiting for approval
  APPROVED
  REJECTED // turned down (reviewNote says why); the member can edit and resubmit
}

/// What kind of thing a Resources-page link points to (drives the icon and filter).
enum ResourceType {
  DOCUMENT
  SPREADSHEET
  WEBSITE
  CAD
  CODE
  VIDEO
  OTHER
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no transport configured (dev) — logged only
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique // always stored lower-cased
  name         String
  passwordHash String
  role         Role
  /// Required for MEMBER and *_LEADER roles (leaders' subteam matches their role). Null for CAPTAIN/MENTOR/TEACHER.
  subteam      Subteam?
  status       AccountStatus @default(PENDING)
  /// Site owner(s). Approves leaders/mentors/teachers and manages accounts.
  isAdmin      Boolean       @default(false)

  // Email notification preferences (each user can switch these off in Settings).
  emailOnQuestion   Boolean @default(true) // staff: a question was asked/followed up in your scope
  emailOnSubmission Boolean @default(true) // staff: someone submitted a task you assigned
  emailOnReply      Boolean @default(true) // everyone: someone replied to your question
  emailOnReview     Boolean @default(true) // everyone: your submission was approved / sent back
  emailOnAssigned   Boolean @default(false) // everyone: you were assigned a new task
  emailOnSignup     Boolean @default(true) // admins: someone registered and needs approval
  emailOnResource   Boolean @default(true) // admins: a member shared a resource that needs approval

  approvedById        String?
  approvedBy          User?     @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approved            User[]    @relation("UserApprovals")
  approvedAt          DateTime?
  lastSeenAt          DateTime?
  /// Last time they opened Announcements (announcements after it, for them, count as new).
  announcementsSeenAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  tasksCreated           Task[]                @relation("TaskCreator")
  assignments            TaskAssignment[]      @relation("AssignmentAssignee")
  reviews                TaskAssignment[]      @relation("AssignmentReviewer")
  questionsAsked         Question[]            @relation("QuestionAsker")
  questionsReceived      Question[]            @relation("QuestionRecipient")
  questionReplies        QuestionReply[]
  resourcesCreated       Resource[]            @relation("ResourceCreator")
  resourcesReviewed      Resource[]            @relation("ResourceReviewer")
  categoriesCreated      TaskCategory[]        @relation("CategoryCreator")
  sponsorshipsOwned      Sponsorship[]         @relation("SponsorshipOwner")
  sponsorshipsCreated    Sponsorship[]         @relation("SponsorshipCreator")
  sponsorshipFiles       SponsorshipFile[]     @relation("SponsorshipFileUploader")
  postersCreated         Poster[]              @relation("PosterCreator")
  fundraisersLed         Fundraiser[]          @relation("FundraiserLead")
  fundraisersCreated     Fundraiser[]          @relation("FundraiserCreator")
  fundraiserHelping      FundraiserVolunteer[] @relation("FundraiserVolunteer")
  attendanceOpened       AttendanceSession[]   @relation("AttendanceOpener")
  attendanceRecords      AttendanceRecord[]    @relation("AttendanceAttendee")
  attendanceMarked       AttendanceRecord[]    @relation("AttendanceMarker")
  attendanceRsvps        AttendanceRsvp[]      @relation("AttendanceRsvpUser")
  attendancePlans        AttendancePlan[]      @relation("AttendancePlanEditor")
  notebooksCreated       Notebook[]            @relation("NotebookCreator")
  notebookPagesMade      NotebookPage[]        @relation("NotebookPageCreator")
  notebookEntries        NotebookEntry[]       @relation("NotebookEntryAuthor")
  notebookEntryEdits     NotebookEntry[]       @relation("NotebookEntryEditor")
  notebookEditLog        NotebookEntryEdit[]   @relation("NotebookEditLogEditor")
  strategiesCreated      Strategy[]            @relation("StrategyCreator")
  purchasesOrdering      PurchaseItem[]        @relation("PurchaseOrderer")
  purchasesCreated       PurchaseItem[]        @relation("PurchaseCreator")
  purchasesUpdated       PurchaseItem[]        @relation("PurchaseStatusChanger")
  teamNotesEdited        TeamNote[]            @relation("TeamNoteEditor")
  partsRequested         Part[]                @relation("PartRequester")
  partsClaimed           Part[]                @relation("PartClaimer")
  calendarEventsMade     CalendarEvent[]       @relation("CalendarEventCreator")
  calendarEventsEdited   CalendarEvent[]       @relation("CalendarEventEditor")
  leagueTeamsAdded       LeagueTeam[]          @relation("LeagueTeamCreator")
  leagueTeamSummaries    LeagueTeam[]          @relation("LeagueTeamSummaryEditor")
  discussionThreads      DiscussionThread[]    @relation("DiscussionThreadAuthor")
  discussionActivity     DiscussionThread[]    @relation("DiscussionLastActivity")
  discussionReplies      DiscussionReply[]     @relation("DiscussionReplyAuthor")
  discussionReads        DiscussionRead[]      @relation("DiscussionReader")
  announcementsPosted    Announcement[]        @relation("AnnouncementAuthor")
  creditsChanged         AttendanceRecord[]    @relation("AttendanceCreditEditor")
  attendanceChangesAbout AttendanceChange[]    @relation("AttendanceChangeSubject")
  attendanceChangesMade  AttendanceChange[]    @relation("AttendanceChangeActor")

  @@index([status, role])
  @@index([subteam, status])
}

model Session {
  id         String   @id @default(cuid())
  /// sha256 of the random cookie token — the raw token never touches the DB.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String        @default("")
  /// Subteam the task belongs to. Null = whole-team task (captain/mentor/teacher/admin only).
  subteam     Subteam?
  /// Calendar day (team timezone) the task should be done by. Stored as a DATE.
  dueDate     DateTime      @db.Date
  priority    Priority      @default(NORMAL)
  /// Category the task is sorted under on the Task dashboard (e.g. Build → Intake). Must belong to the task's subteam.
  categoryId  String?
  category    TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// "Let people sign up" task (true) vs. "Assign people" (false). Closing sign-ups (signupOpen) doesn't change it.
  signupMode  Boolean       @default(false)
  /// While on, people in the task's subteam (anyone, for whole-team tasks) can sign themselves up. Only ever on for signupMode tasks.
  signupOpen  Boolean       @default(false)
  /// Most people the task takes, counting everyone on it. Null = no limit.
  signupLimit Int?
  createdById String
  createdBy   User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignments TaskAssignment[]
  questions   Question[]

  @@index([dueDate])
  @@index([subteam, dueDate])
  @@index([createdById])
  @@index([categoryId])
}

/// A kind of job inside a subteam, e.g. Build → Intake, Drivetrain, CAD. Leaders add them with “+”.
model TaskCategory {
  id          String   @id @default(cuid())
  /// Subteam the category belongs to. Null = whole-team category.
  subteam     Subteam?
  name        String
  /// Lower-cased name, so "Intake" and "intake" can't both exist in one subteam.
  nameKey     String
  /// Display order inside the subteam (ascending).
  position    Int      @default(0)
  createdById String?
  createdBy   User?    @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
  parts Part[]

  @@unique([subteam, nameKey])
  @@index([subteam, position])
}

model TaskAssignment {
  id             String           @id @default(cuid())
  taskId         String
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("AssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  status         AssignmentStatus @default(TODO)
  submittedAt    DateTime?
  submissionNote String?
  reviewedById   String?
  reviewedBy     User?            @relation("AssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  /// The person signed themselves up (from the Task dashboard) instead of being assigned by a leader.
  selfAssigned   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([taskId, userId])
  @@index([userId, status])
  @@index([status, submittedAt])
}

model Question {
  id                String         @id @default(cuid())
  title             String
  body              String
  askerId           String
  asker             User           @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  /// Specific leader/mentor/teacher the question is addressed to. Null = the leaders of `subteam` (or captains if subteam is null).
  recipientId       String?
  recipient         User?          @relation("QuestionRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  subteam           Subteam?
  /// Optional link to the task the question is about.
  taskId            String?
  task              Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  status            QuestionStatus @default(OPEN)
  /// Ids of the messages this question was posted as in the leaders' Discord channel (so deleting it can remove them).
  discordMessageIds String[]       @default([])
  lastActivityAt    DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  replies QuestionReply[]

  @@index([askerId, lastActivityAt])
  @@index([recipientId, status])
  @@index([subteam, status])
  @@index([status, lastActivityAt])
}

model QuestionReply {
  id                String   @id @default(cuid())
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body              String
  /// Ids of the messages this reply was posted as in the leaders' Discord channel.
  discordMessageIds String[] @default([])
  createdAt         DateTime @default(now())

  @@index([questionId, createdAt])
}

/// Every outgoing email attempt, so admins can debug "I never got the email".
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  kind      String // notification event type, e.g. "task.submitted"
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

/// Fixed-window rate limiter shared across server instances (login, register, password reset).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// A link or uploaded file on the Resources page (team docs, code, CAD, inventory tracker, game manual…).
/// Stored in the database — not in code — because the repo is public and some links are team-only.
model Resource {
  id           String         @id @default(cuid())
  title        String
  /// The link. Empty for uploaded files (see `file`).
  url          String         @default("")
  description  String         @default("")
  type         ResourceType   @default(OTHER)
  /// Heading the link is shown under, e.g. "Team Docs" or "Project assets". Empty = "Other".
  group        String         @default("")
  /// Pinned resources are shown first.
  pinned       Boolean        @default(false)
  /// Extra quick links shown as buttons on the card: [{ "label": "Meeting Agenda", "url": "https://…" }].
  links        Json           @default("[]")
  /// Members' submissions start PENDING; people with admin access add APPROVED ones directly.
  status       ResourceStatus @default(APPROVED)
  reviewedById String?
  reviewedBy   User?          @relation("ResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Why it was turned down (shown to the member).
  reviewNote   String?
  createdById  String?
  createdBy    User?          @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  file ResourceFile?

  @@index([pinned, group])
  @@index([status, createdAt])
  @@index([createdById, status])
}

/// An uploaded file behind a Resource (code, a PDF, a small CAD export…). Kept small (see LIMITS.resourceFileMaxBytes).
model ResourceFile {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  /// Original file name, cleaned up (no paths).
  filename    String
  /// Type reported by the browser. Only used to pick a safe way to serve it.
  contentType String
  size        Int
  /// The file's bytes when it is stored in Postgres. Null when it lives in Cloudflare R2 (see storageKey).
  data        Bytes?
  /// Object key in Cloudflare R2 when the file is stored there (src/server/files/object-store.ts). Null = in Postgres.
  storageKey  String?  @unique
  createdAt   DateTime @default(now())
}

/// Where a sponsorship ask stands (the stages the Business team used in their spreadsheet).
enum SponsorshipStage {
  NOT_STARTED // "Haven't started"
  DO_SOON
  IN_PROGRESS // "Needs work"
  SUBMITTED // sent, waiting to hear back
  ACCEPTED
  DECLINED
  FINISHED // received / wrapped up
}

/// One sponsor, donor, or grant the Business team is asking (Sponsorships page).
model Sponsorship {
  id             String           @id @default(cuid())
  /// Company, brand, or grant, e.g. "Polymaker" or "FIRST team grant".
  name           String
  /// Their website or application page (http(s) only). Empty = none.
  website        String           @default("")
  contactName    String           @default("")
  contactEmail   String           @default("")
  /// What we're hoping to get, e.g. "$1,000" or "10 spools of filament".
  asking         String           @default("")
  /// Money received, in whole US dollars. Null = nothing yet (or not money).
  amountReceived Int?
  stage          SponsorshipStage @default(NOT_STARTED)
  /// Team member handling it.
  ownerId        String?
  owner          User?            @relation("SponsorshipOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  submittedOn    DateTime?        @db.Date
  acceptedOn     DateTime?        @db.Date
  /// Application deadline.
  closesOn       DateTime?        @db.Date
  notes          String           @default("")
  createdById    String?
  createdBy      User?            @relation("SponsorshipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  files SponsorshipFile[]

  @@index([stage, closesOn])
  @@index([ownerId])
}

/// A file attached to a sponsorship, e.g. a paper application form to print and fill out, or the filled-out copy.
/// Stored in Postgres like ResourceFile, so it counts toward the same storage cap.
model SponsorshipFile {
  id            String      @id @default(cuid())
  sponsorshipId String
  sponsorship   Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  /// Original file name, cleaned up (no paths).
  filename      String
  /// Type reported by the browser. Only used to pick a safe way to serve it.
  contentType   String
  size          Int
  /// The file's bytes when it is stored in Postgres. Null when it lives in Cloudflare R2 (see storageKey).
  data          Bytes?
  /// Object key in Cloudflare R2 when the file is stored there (src/server/files/object-store.ts). Null = in Postgres.
  storageKey    String?     @unique
  uploadedById  String?
  uploadedBy    User?       @relation("SponsorshipFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([sponsorshipId, createdAt])
}

/// Small shared notes edited in the app, by key (e.g. "sponsorship-info": team address, contact person, links).
model TeamNote {
  key         String   @id
  body        String   @default("")
  updatedById String?
  updatedBy   User?    @relation("TeamNoteEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

/// How a part gets made (Parts queue).
enum PartProcess {
  PRINT_3D
  LASER_CUT
  CNC
  CUT // saw / shear / hand cut
  MACHINE // mill, lathe, drill press
  OTHER
}

/// NEEDED (up for grabs) -> CLAIMED (someone is making it) -> DONE.
enum PartStatus {
  NEEDED
  CLAIMED
  DONE
}

/// A part someone needs printed, cut, or machined. The queue is ordered by `position` (smaller = sooner).
model Part {
  id            String        @id @default(cuid())
  name          String
  process       PartProcess   @default(PRINT_3D)
  quantity      Int           @default(1)
  /// e.g. "PLA", "1/8 in aluminum".
  material      String        @default("")
  /// Link to the CAD / STL / drawing (http(s) only). Empty = none.
  fileUrl       String        @default("")
  notes         String        @default("")
  /// What it's for, e.g. Build → Intake (optional).
  categoryId    String?
  /// What it's for, typed in, when it isn't one of the task categories (e.g. "Practice field"). Empty when categoryId is set.
  forLabel      String        @default("")
  category      TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  neededBy      DateTime?     @db.Date
  /// Queue order among parts that aren't done (ascending = make it sooner).
  position      Int           @default(0)
  status        PartStatus    @default(NEEDED)
  requestedById String?
  requestedBy   User?         @relation("PartRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  claimedById   String?
  claimedBy     User?         @relation("PartClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt     DateTime?
  doneAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, position])
  @@index([claimedById, status])
}

/// A poster or flyer on the Posters page (whole team): an uploaded image/PDF and/or a link to the design (Canva, Drive…).
model Poster {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  /// Link to the editable design or the full-size file (http(s) only). Empty = none.
  link        String    @default("")
  /// What it's for, e.g. "Library demo" or "Recruiting" (optional).
  event       String    @default("")
  /// When that event is (optional); drives "Upcoming" vs "Past".
  eventDate   DateTime? @db.Date
  createdById String?
  createdBy   User?     @relation("PosterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  file PosterFile?

  @@index([eventDate])
  @@index([createdAt])
}

/// The uploaded image/PDF behind a Poster. Stored in Postgres like ResourceFile (same storage cap).
model PosterFile {
  id          String   @id @default(cuid())
  posterId    String   @unique
  poster      Poster   @relation(fields: [posterId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  /// The file's bytes when it is stored in Postgres. Null when it lives in Cloudflare R2 (see storageKey).
  data        Bytes?
  /// Object key in Cloudflare R2 when the file is stored there (src/server/files/object-store.ts). Null = in Postgres.
  storageKey  String?  @unique
  createdAt   DateTime @default(now())
}

/// What kind of fundraiser it is (drives the icon).
enum FundraiserKind {
  EVENT // car wash, restaurant night, demo day…
  SALE // bake sale, merch, candy grams
  ONLINE // donation page, crowdfunding
  OTHER
}

enum FundraiserStatus {
  PLANNING
  UPCOMING
  ACTIVE // happening now
  DONE
  CANCELLED
}

/// A fundraiser on the Fundraising page (whole team sees it and can sign up to help).
model Fundraiser {
  id             String           @id @default(cuid())
  name           String
  kind           FundraiserKind   @default(EVENT)
  status         FundraiserStatus @default(PLANNING)
  description    String           @default("")
  location       String           @default("")
  /// Donation page, sign-up sheet, flyer… (http(s) only). Empty = none.
  link           String           @default("")
  startsOn       DateTime?        @db.Date
  endsOn         DateTime?        @db.Date
  /// Goal and money raised so far, in whole US dollars.
  goalAmount     Int?
  raisedAmount   Int              @default(0)
  /// Team member running it.
  leadId         String?
  lead           User?            @relation("FundraiserLead", fields: [leadId], references: [id], onDelete: SetNull)
  /// Most helpers it needs. Null = no limit.
  volunteerLimit Int?
  createdById    String?
  createdBy      User?            @relation("FundraiserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  volunteers FundraiserVolunteer[]

  @@index([status, startsOn])
}

/// Someone who tapped "I'll help" on a fundraiser.
model FundraiserVolunteer {
  id           String     @id @default(cuid())
  fundraiserId String
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("FundraiserVolunteer", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([fundraiserId, userId])
  @@index([userId])
}

/// Regular after-school practice, or the school's Flex period (Tuesdays and Thursdays by default).
enum AttendanceKind {
  REGULAR
  FLEX
}

/// A member's answer to "Coming?" for a day. FLEX answers are only YES or NO.
enum RsvpAnswer {
  YES
  HALF
  NO
}

enum CheckInMethod {
  QR // scanned the rotating QR code
  CODE // typed the 6-digit code shown with it
  MANUAL // added by the person running attendance
}

/// One time attendance was taken (at most one REGULAR and one FLEX per day). Opened by a teacher,
/// the Business leader, the captain, a mentor, or an owner, who shows a rotating QR code everyone scans.
model AttendanceSession {
  id         String         @id @default(cuid())
  /// Calendar day (team timezone).
  date       DateTime       @db.Date
  kind       AttendanceKind
  /// Random secret the rotating QR / 6-digit codes are derived from (HMAC). Never sent to the browser.
  secret     String
  openedById String?
  openedBy   User?          @relation("AttendanceOpener", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt   DateTime       @default(now())
  /// Check-ins stop when this is set (also after the day ends).
  closedAt   DateTime?
  /// "What we did" — goes into the two-week report.
  note       String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  records AttendanceRecord[]
  changes AttendanceChange[]

  @@unique([date, kind])
}

/// Someone was there (checked in by QR/code, or added by hand).
/// What a check-in counts as (members pick it when they check in: 1, 2/3, 1/2, 1/3, 1/2 EC, 1 EC, 1/2 Flex, 1 Flex).
enum AttendanceCreditKind {
  REGULAR
  EXTRA // "EC", extra credit
  FLEX
}

model AttendanceRecord {
  id                String               @id @default(cuid())
  sessionId         String
  session           AttendanceSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation("AttendanceAttendee", fields: [userId], references: [id], onDelete: Cascade)
  method            CheckInMethod
  checkedInAt       DateTime             @default(now())
  /// Who added them by hand (MANUAL).
  markedById        String?
  markedBy          User?                @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  /// How much this check-in counts toward the weekly target, in sixths (6 = 1, 4 = 2/3, 3 = 1/2, 2 = 1/3).
  credit            Int                  @default(6)
  /// Regular, extra credit (EC), or Flex. All of them count toward the weekly target.
  creditKind        AttendanceCreditKind @default(REGULAR)
  /// Set when someone other than the attendee (a runner) changed the credit.
  creditChangedAt   DateTime?
  creditChangedById String?
  creditChangedBy   User?                @relation("AttendanceCreditEditor", fields: [creditChangedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId])
}

/// A member's plan for a day: coming to regular practice (Yes/Half/No) and, on Flex days, to Flex (Yes/No).
model AttendanceRsvp {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("AttendanceRsvpUser", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  regular   RsvpAnswer?
  flex      RsvpAnswer?
  /// Optional, e.g. "leaving at 5".
  note      String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// The plan for a day ("drive practice, intake CAD"), written ahead by the captain/leaders; members see it when they answer.
model AttendancePlan {
  date        DateTime @id @db.Date
  plan        String   @default("")
  updatedById String?
  updatedBy   User?    @relation("AttendancePlanEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

/// A team notebook, e.g. "Hardware Notebook" (the engineering notebook, split the way the team likes).
/// The captain (and other all-scope staff) add, rename, reorder, and delete notebooks.
model Notebook {
  id          String   @id @default(cuid())
  title       String
  /// Shown before the title, e.g. "🔧". Empty = a plain notebook icon.
  emoji       String   @default("")
  description String   @default("")
  /// Whose notebook it is (its leaders manage its pages). Null = whole team.
  subteam     Subteam?
  /// Display order (ascending).
  position    Int      @default(0)
  createdById String?
  createdBy   User?    @relation("NotebookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages NotebookPage[]

  @@index([position])
}

/// A page (section) inside a notebook, e.g. Hardware Notebook → "Intake".
model NotebookPage {
  id          String   @id @default(cuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  title       String
  position    Int      @default(0)
  createdById String?
  createdBy   User?    @relation("NotebookPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries NotebookEntry[]

  @@index([notebookId, position])
}

/// One dated entry on a page. The date/time and author are stamped automatically when it's written;
/// every later change is logged in NotebookEntryEdit (who, when, what it said before).
model NotebookEntry {
  id             String       @id @default(cuid())
  pageId         String
  page           NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Optional heading, e.g. "Tested the new roller compliance".
  title          String       @default("")
  body           String
  authorId       String?
  author         User?        @relation("NotebookEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// When it was written (stamped by the server).
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastEditedById String?
  lastEditedBy   User?        @relation("NotebookEntryEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime?

  images NotebookImage[]
  edits  NotebookEntryEdit[]

  @@index([pageId, createdAt])
}

/// History of changes to an entry: who changed it, when, and what it said before.
model NotebookEntryEdit {
  id            String        @id @default(cuid())
  entryId       String
  entry         NotebookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  editorId      String?
  editor        User?         @relation("NotebookEditLogEditor", fields: [editorId], references: [id], onDelete: SetNull)
  editedAt      DateTime      @default(now())
  previousTitle String
  previousBody  String

  @@index([entryId, editedAt])
}

/// A picture on a notebook entry (CAD screenshot, test photo…). Stored in Postgres like other uploads (same storage cap).
model NotebookImage {
  id          String        @id @default(cuid())
  entryId     String
  entry       NotebookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  /// The file's bytes when it is stored in Postgres. Null when it lives in Cloudflare R2 (see storageKey).
  data        Bytes?
  /// Object key in Cloudflare R2 when the file is stored there (src/server/files/object-store.ts). Null = in Postgres.
  storageKey  String?       @unique
  width       Int?
  height      Int?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([entryId, position])
}

/// What part of the game a strategy is about.
enum StrategyKind {
  AUTO
  TELEOP
  ENDGAME
  MATCH // whole-match plan / alliance play
  SCOUTING
  OTHER
}

/// A strategy anyone on the team wrote up on the Strategy page (next to the Pedro Pathing visualizer):
/// a description, an optional link (video, doc), and files such as .pp path files, images, or PDFs.
model Strategy {
  id          String       @id @default(cuid())
  title       String
  kind        StrategyKind @default(AUTO)
  description String       @default("")
  /// Video, doc, or anything else (http(s) only). Empty = none.
  link        String       @default("")
  /// Pinned ones are shown first (people with admin access pin).
  pinned      Boolean      @default(false)
  /// Set when it's about another team in the league ("Other teams" on the Strategy page). Null = one of ours.
  teamId      String?
  team        LeagueTeam?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?        @relation("StrategyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  files StrategyFile[]

  @@index([pinned, updatedAt])
  @@index([teamId, updatedAt])
}

/// Another team in our league (Strategy → Other teams): what we know about how they play, plus
/// strategies written about them (e.g. their auto traced in the Pedro Pathing visualizer as a .pp file).
model LeagueTeam {
  id                 String    @id @default(cuid())
  /// FTC team number, e.g. 9040.
  number             Int       @unique
  name               String
  city               String    @default("")
  /// "Their strategy at a glance", written by anyone on the team.
  summary            String    @default("")
  summaryUpdatedAt   DateTime?
  summaryUpdatedById String?
  summaryUpdatedBy   User?     @relation("LeagueTeamSummaryEditor", fields: [summaryUpdatedById], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?     @relation("LeagueTeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  strategies Strategy[]
}

/// A file on a strategy: a Pedro Pathing .pp path, a field diagram, a PDF… Stored in Postgres (same storage cap).
model StrategyFile {
  id          String   @id @default(cuid())
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  /// The file's bytes when it is stored in Postgres. Null when it lives in Cloudflare R2 (see storageKey).
  data        Bytes?
  /// Object key in Cloudflare R2 when the file is stored there (src/server/files/object-store.ts). Null = in Postgres.
  storageKey  String?  @unique
  createdAt   DateTime @default(now())

  @@index([strategyId, createdAt])
}

/// Where an item on the Order list stands.
enum PurchaseStatus {
  REQUESTED // someone needs it
  APPROVED // OK'd to buy
  ORDERED
  DONE // arrived / handled
  NOT_NEEDED // "N/A": cancelled or no longer needed
}

/// One thing the team needs to buy (the Order list, replacing the "Purchase List" sheet).
model PurchaseItem {
  id                String         @id @default(cuid())
  /// What to buy, e.g. "Flywheels for the outtake".
  description       String
  /// SKU, where to find it, anything else, e.g. "SKU am-5437 (2)".
  notes             String         @default("")
  /// Product page (http(s) only). Empty = none.
  link              String         @default("")
  vendor            String         @default("")
  quantity          Int?
  /// Price for the whole line, in cents. Null = unknown.
  costCents         Int?
  /// Which subteam it's for. Null = whole team.
  subteam           Subteam?
  status            PurchaseStatus @default(REQUESTED)
  /// The person ordering it ("Orderer").
  ordererId         String?
  orderer           User?          @relation("PurchaseOrderer", fields: [ordererId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?          @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?          @relation("PurchaseStatusChanger", fields: [statusChangedById], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([ordererId])
}

enum CalendarEventKind {
  MEET
  ILT
  SCRIMMAGE
  COMPETITION
  /// An extra team meeting on top of the regular days (Attendance schedule): counts as a meeting day everywhere.
  MEETING
  OUTREACH
  TEAM
  DEADLINE
  OTHER
}

/// One thing on the Team calendar: a league meet, the ILT, a scrimmage, outreach, a deadline…
model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  kind        CalendarEventKind @default(MEET)
  /// First day (team timezone). Multi-day events also have `endsOn`.
  startsOn    DateTime          @db.Date
  /// Last day, inclusive. Null = one day.
  endsOn      DateTime?         @db.Date
  /// "HH:MM" (24 h, team timezone). Null = all day / time not known yet.
  startTime   String?
  endTime     String?
  /// Venue name and/or address.
  location    String            @default("")
  /// FTC Events page, sign-up form… (http(s) only). Empty = none.
  link        String            @default("")
  notes       String            @default("")
  /// Set on events loaded from a built-in season schedule so loading it again never duplicates them.
  sourceKey   String?           @unique
  createdById String?
  createdBy   User?             @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?             @relation("CalendarEventEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startsOn])
  @@index([kind, startsOn])
}

enum DiscussionCategory {
  GENERAL
  SOFTWARE
  BUILD
  BUSINESS
  IDEAS
  OFF_TOPIC
}

/// A thread on the team-wide Discussion page (unlike Questions, everyone ACTIVE sees and replies).
model DiscussionThread {
  id               String             @id @default(cuid())
  title            String
  body             String
  category         DiscussionCategory @default(GENERAL)
  authorId         String?
  author           User?              @relation("DiscussionThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Pinned threads are listed first (people with admin access pin).
  pinned           Boolean            @default(false)
  /// Locked threads take no new replies (people with admin access lock).
  locked           Boolean            @default(false)
  replyCount       Int                @default(0)
  /// The thread's creation or its newest reply; the list is ordered by it.
  lastActivityAt   DateTime           @default(now())
  lastActivityById String?
  lastActivityBy   User?              @relation("DiscussionLastActivity", fields: [lastActivityById], references: [id], onDelete: SetNull)
  /// Set when the author changes the title or text.
  editedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  replies DiscussionReply[]
  reads   DiscussionRead[]

  @@index([pinned, lastActivityAt])
  @@index([category, lastActivityAt])
  @@index([authorId])
}

model DiscussionReply {
  id        String           @id @default(cuid())
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?            @relation("DiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([threadId, createdAt])
  @@index([authorId])
}

/// When someone last opened a thread (for "new replies" markers and the nav count).
model DiscussionRead {
  userId     String
  user       User             @relation("DiscussionReader", fields: [userId], references: [id], onDelete: Cascade)
  threadId   String
  thread     DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lastReadAt DateTime

  @@id([userId, threadId])
  @@index([threadId])
}

/// A post on Announcements: from leaders, the captain, mentors, teachers, or owners, to the whole team or one subteam.
model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  /// Who it's for. Null = the whole team.
  subteam   Subteam?
  /// Pinned ones are listed first.
  pinned    Boolean   @default(false)
  authorId  String?
  author    User?     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Set when the title or text changes after posting.
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([subteam, createdAt])
  @@index([pinned, createdAt])
}

/// What an admin did to someone's attendance (the change log only people with admin access see).
enum AttendanceChangeAction {
  ADDED // added by hand (with a partial / EC credit, or "No credit" = 0)
  REMOVED // their check-in was taken off
  CREDIT_CHANGED // their credit changed (e.g. 1 → 1/2, or 0 → 1/3)
  SESSION_DELETED // a whole attendance session was deleted
}

/// One change an admin made to attendance. Copies the session's date/kind and the person's name so the log
/// survives deleted sessions and accounts.
model AttendanceChange {
  id          String                 @id @default(cuid())
  sessionId   String?
  session     AttendanceSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionDate DateTime               @db.Date
  sessionKind AttendanceKind
  /// Whose attendance changed (null for SESSION_DELETED, or when the account was deleted).
  userId      String?
  user        User?                  @relation("AttendanceChangeSubject", fields: [userId], references: [id], onDelete: SetNull)
  userName    String                 @default("")
  changedById String?
  changedBy   User?                  @relation("AttendanceChangeActor", fields: [changedById], references: [id], onDelete: SetNull)
  action      AttendanceChangeAction
  /// Credit before / after, in sixths (null = no record).
  fromCredit  Int?
  fromKind    AttendanceCreditKind?
  toCredit    Int?
  toKind      AttendanceCreditKind?
  createdAt   DateTime               @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([userId, createdAt])
  @@index([changedById, createdAt])
}

/// Objects to delete from Cloudflare R2. Filled by database triggers whenever a file row that lives in R2 is
/// deleted (including cascades), then emptied by the app (src/server/files/object-store.ts), so nothing is left behind.
model FileDeletion {
  storageKey String   @id
  createdAt  DateTime @default(now())
  attempts   Int      @default(0)
}
